+/** Registra as roots em uso (chamado por createApp) para consumidores fora do Express, como as ferramentas MCP. */
+export function setActiveWorkspaceRoots(config: WorkspaceRootsConfig): void {
+  activeConfig = config;
+}
+
+/** Roots ativas; sem app montado (ex.: testes), cai no parse do ambiente. */
+export function getActiveWorkspaceRoots(): WorkspaceRootsConfig {
+  return activeConfig ?? parseWorkspaceRootsConfig(process.env);
+}
