diff -ruN -x node_modules -x dist -x engine-dist -x '*.patch' orig/src/server/scanDirectory.ts b/src/server/scanDirectory.ts
--- a/src/server/scanDirectory.ts	1970-01-01 00:00:00.000000000 +0000
