 }
+
+/** Result of validating a path that the server may WRITE to (may not exist yet). */
+export type WritablePathValidation =
+  | { ok: true; resolvedPath: string }
+  | { ok: false; status: 400 | 403; error: string };
+
+/** Walks up from `p` to the nearest existing ancestor and returns its canonical path. */
+function realpathOfNearestAncestor(p: string): string | null {
+  let current = p;
+  for (;;) {
+    const real = realpathOrNull(current);
+    if (real !== null) return real;
+    const parent = path.dirname(current);
+    if (parent === current) return null;
+    current = parent;
+  }
+}
+
+/**
+ * Validates a project path that will be used for disk WRITES
+ * (git-sync, git-init, stage/commit/branch). Unlike scan-directory the
+ * target may not exist yet, so the symlink boundary is checked against
+ * the nearest existing ancestor. Same fail-closed rules and generic
+ * client messages as validateScanDirectoryPath (audit finding A1).
+ */
+export function validateWritableProjectPath(
+  projectPath: unknown,
+  config: WorkspaceRootsConfig
+): WritablePathValidation {
+  if (typeof projectPath !== 'string' || projectPath === '') {
+    return { ok: false, status: 400, error: 'Project path is required' };
+  }
+  if (projectPath.includes('\0')) {
+    return { ok: false, status: 400, error: 'Project path contains forbidden null bytes' };
+  }
+
+  const resolvedPath = path.resolve(projectPath);
+  if (!isPathWithinRoots(resolvedPath, config.roots)) {
+    logRejection('write_outside_workspace_roots', projectPath, resolvedPath, config.roots);
+    return { ok: false, status: 403, error: 'Project path is outside the allowed workspace roots' };
+  }
+
+  const realAncestor = realpathOfNearestAncestor(resolvedPath);
+  const realRoots = config.roots.map((root) => realpathOrNull(root) ?? root);
+  if (realAncestor === null || !isPathWithinRoots(realAncestor, realRoots)) {
+    logRejection('write_symlink_escape', projectPath, realAncestor ?? resolvedPath, config.roots);
+    return { ok: false, status: 403, error: 'Project path is outside the allowed workspace roots' };
+  }
+
+  return { ok: true, resolvedPath };
+}
+
+let activeConfig: WorkspaceRootsConfig | null = null;
